# Server Configuration
PORT=5000

# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://...

# ─── Admin Auth ───────────────────────────────────────────────────
# Password for the /admin login page
ADMIN_PASSWORD=your-strong-password-here
# Long random secret for signing the session cookie
ADMIN_SESSION_SECRET=your-random-secret-key-here

# ─── Email Notifications (optional) ──────────────────────────────
# Get a free key at https://resend.com (free tier: 3,000 emails/month)
RESEND_API_KEY=
# Your email address to receive new contact form alerts
RESEND_TO_EMAIL=

# ─── Site URL (optional, used in email links) ─────────────────────
NEXT_PUBLIC_SITE_URL=https://yourdomain.com
