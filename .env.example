# Server Configuration
PORT=5000

# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://...

# ─── Admin Auth ───────────────────────────────────────────────────
# Password for the /admin login page
ADMIN_PASSWORD=change-me-to-a-strong-password
# Long random secret for signing the session cookie (use: openssl rand -hex 32)
ADMIN_SESSION_SECRET=change-me-generate-with-openssl-rand-hex-32

# ─── Email Notifications (optional) ──────────────────────────────
# Get a free key at https://resend.com (free tier: 3,000 emails/month)
RESEND_API_KEY=
# Your email address to receive new contact form alerts
RESEND_TO_EMAIL=

# ─── Site URL (optional, used in email links) ─────────────────────
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# ─── Contact Numbers (used in FloatingContact widget) ─────────────
NEXT_PUBLIC_WHATSAPP_NUMBER=919328311556
NEXT_PUBLIC_PHONE_NUMBER=+919328311556
